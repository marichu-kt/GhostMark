{
  "name": "ghostmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Professional PDF watermarking. Private by design.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
